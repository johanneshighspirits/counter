rules_version = '2';

// The counter shares the (default) database in the jaybo-saver Firebase
// project with an old app that is no longer used. Deploying this file
// replaces the rules for the whole database, so everything outside teams/ is
// closed to browsers.

service cloud.firestore {
  match /databases/{database}/documents {
    match /teams/{teamSlug} {
      allow read: if true;

      match /events/{eventSlug} {
        allow read: if true;

        // Door and ticket devices may only change one counter at a time,
        // together with exactly one new log entry (lastLogId). Creating teams
        // and events, max count and resets go through firebase-admin.
        //
        // Rules see the stored event, not the one a transaction read. When
        // clicks overlap, a click's transaction may have read an older value,
        // and Firestore must get to make it retry instead of the rules
        // denying it. So changes are bounded loosely rather than to exactly
        // one click.
        allow update: if
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['count', 'ticketsSold', 'lastLogId'])
          && request.resource.data.lastLogId is string
          && !exists(/databases/$(database)/documents/teams/$(teamSlug)/events/$(eventSlug)/log/$(request.resource.data.lastLogId))
          && existsAfter(/databases/$(database)/documents/teams/$(teamSlug)/events/$(eventSlug)/log/$(request.resource.data.lastLogId))
          && isCounter(request.resource.data.count)
          && isCounter(request.resource.data.ticketsSold)
          && math.abs(request.resource.data.count - resource.data.get('count', 0)) <= 10
          && math.abs(request.resource.data.ticketsSold - resource.data.get('ticketsSold', 0)) <= 40;

        match /log/{entryId} {
          // The stats page listens for new entries
          allow read: if true;
          allow create: if
            request.resource.data.keys()
              .hasOnly(['type', 'delta', 'newCount', 'source', 'createdAt'])
            && request.resource.data.keys()
              .hasAll(['type', 'delta', 'newCount', 'source', 'createdAt'])
            && request.resource.data.source in ['main-door', 'ticket_office']
            && request.resource.data.createdAt == request.time
            && request.resource.data.delta is int
            && request.resource.data.newCount is int
            && matchesCounterChange(
              request.resource.data,
              entryId,
              get(/databases/$(database)/documents/teams/$(teamSlug)/events/$(eventSlug)).data,
              getAfter(/databases/$(database)/documents/teams/$(teamSlug)/events/$(eventSlug)).data
            );
        }

        // private/pin (admin PIN hash) has no rule, so only firebase-admin
        // on the server can read or write it.
      }
    }

    function isCounter(value) {
      return value is int && value >= 0;
    }

    // The entry must be the event's lastLogId in the same write and carry
    // its counter's new value. It isn't checked against the stored value
    // plus delta, since an overlapping click may have read an older value
    // (see the event's update rule).
    function matchesCounterChange(entry, entryId, before, after) {
      let field = entry.type == 'occupancy' ? 'count' : 'ticketsSold';
      let otherField = entry.type == 'occupancy' ? 'ticketsSold' : 'count';
      return entry.type in ['occupancy', 'tickets']
        && after.lastLogId == entryId
        && after[field] == entry.newCount
        && after.get(otherField, 0) == before.get(otherField, 0)
        && (entry.type == 'occupancy'
          ? entry.delta in [-1, 1]
          : entry.delta in [-1, 1, 2, 3, 4]);
    }
  }
}
